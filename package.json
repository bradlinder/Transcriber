{
  "name": "transcriber",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const h=require('http'),f=require('fs');h.createServer((q,s)=>{s.writeHead(200,{'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-cache'});s.end(f.readFileSync('index.html'))}).listen(3000,'0.0.0.0',()=>console.log('Preview running on port 3000'))\"",
    "build": "node -e \"console.log('Static Android preview ready')\"",
    "preview": "npm run dev"
  }
}
