{
  "name": "transcriber",
  "private": true,
  "version": "0.76.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const h=require('http'),f=require('fs');h.createServer((q,s)=>{let html=f.readFileSync('index.html','utf8');try{const m=f.readFileSync('app/build.gradle','utf8').match(/versionName\\s+'([^']+)'/);if(m)html=html.replace(/<p>[^<]*<\\/p>/,'<p>v'+m[1]+'</p>');}catch{}s.writeHead(200,{'Content-Type':'text/html; charset=utf-8','Cache-Control':'no-cache'});s.end(html);}).listen(3000,'0.0.0.0',()=>console.log('Preview running on port 3000'))\"",
    "build": "node -e \"console.log('Static Android preview ready')\"",
    "preview": "npm run dev"
  }
}
